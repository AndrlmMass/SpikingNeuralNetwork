# Generated outputs (runtime only)
model/
results/
figures/
profile/
plots/

# Paper deliverables, re-included from the TOP-LEVEL results/ only. The prose (.tex)
# exists nowhere else and is not regenerable; the figures and tables are what the article
# compiles against. Everything else under results/ -- run JSON, feature npz, weight
# checkpoints, ~625 MB of it -- stays ignored, as do the nested experiments/*/results/
# directories still caught by the unanchored `results/` rule above.
#
# Order matters twice: git cannot re-include a file whose parent directory is excluded, so
# `!/results/` has to un-exclude the directory before `/results/*` filters its contents;
# and `!/results/figures/` has to sit after `figures/`, which would otherwise match it.
!/results/
/results/*
!/results/*.tex
!/results/tables/
!/results/figures/

# Analysis inputs, so the GLMMs, tables and figures regenerate on a fresh clone: the R
# scripts and their CSVs, the phase-2 run JSON, and the OOD run JSON/CSV plus the two npz
# files its AUROC and confidence-overlap plots read.
# Same rule as above, one level at a time: un-exclude a directory, then re-filter its
# contents. The un-excludes also override the unanchored `model/` and `results/` rules,
# which would otherwise catch interp/model/ and mnist_family_sweep/results/.
!/results/interp/
/results/interp/*
!/results/interp/model/
/results/interp/model/*
!/results/interp/model/*.R
!/results/interp/model/*.csv
!/results/interp/json/
/results/interp/json/*
!/results/interp/json/experiments/
/results/interp/json/experiments/*
!/results/interp/json/experiments/RF_article/
/results/interp/json/experiments/RF_article/*
!/results/interp/json/experiments/RF_article/interp/
/results/interp/json/experiments/RF_article/interp/*
!/results/interp/json/experiments/RF_article/interp/mnist_family_sweep/
/results/interp/json/experiments/RF_article/interp/mnist_family_sweep/*
!/results/interp/json/experiments/RF_article/interp/mnist_family_sweep/results/
/results/interp/json/experiments/RF_article/interp/mnist_family_sweep/results/*
!/results/interp/json/experiments/RF_article/interp/mnist_family_sweep/results/run_20260819_112250/
!/results/ood_mnist/
/results/ood_mnist/*
!/results/ood_mnist/run1/
/results/ood_mnist/run1/*
!/results/ood_mnist/run1/mnist_ood_s0/
/results/ood_mnist/run1/mnist_ood_s0/*
!/results/ood_mnist/run1/mnist_ood_s0/*.json
!/results/ood_mnist/run1/mnist_ood_s0/*.csv
!/results/ood_mnist/run1/mnist_ood_s0/stats/
/results/ood_mnist/run1/mnist_ood_s0/stats/*
!/results/ood_mnist/run1/mnist_ood_s0/stats/*.jsonl
!/results/ood_mnist/run1/mnist_ood_s0/uncertainty_features.npz
!/results/ood_mnist/run1/mnist_ood_s0/weights/
/results/ood_mnist/run1/mnist_ood_s0/weights/*
!/results/ood_mnist/run1/mnist_ood_s0/weights/checkpoint.npz

